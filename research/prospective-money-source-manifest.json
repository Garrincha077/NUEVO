{
  "contract": "GMLI prospective Money Core input capture",
  "version": 2,
  "methodology_status": "FROZEN_SPEC",
  "purpose": "Preserve exact source bytes for future Money Core promotion vintages before any transformation or test execution.",
  "guardrails": {
    "no_retuning": true,
    "no_core_auto_update": true,
    "all_required_sources_must_be_validated": true,
    "raw_bytes_must_be_preserved_before_transform": true,
    "unresolved_sources_fail_closed": true
  },
  "required_sources": [
    {
      "id": "US_M2SL",
      "region": "US",
      "role": "money_signal_and_weight_input",
      "status": "VALIDATED_FETCH",
      "url": "https://fred.stlouisfed.org/graph/fredgraph.csv?id=M2SL",
      "filename": "us-fred-m2sl.csv",
      "source_authority": "Federal Reserve / FRED"
    },
    {
      "id": "EA_M2",
      "region": "EA",
      "role": "money_signal_and_weight_input",
      "status": "VALIDATED_FETCH",
      "url": "https://data-api.ecb.europa.eu/service/data/BSI/M.U2.Y.V.M20.X.1.U2.2300.Z01.E?format=csvdata",
      "filename": "ea-ecb-m2.csv",
      "source_authority": "European Central Bank"
    },
    {
      "id": "AU_BROAD_MONEY_SIGNAL",
      "region": "AU",
      "role": "money_signal_input",
      "status": "VALIDATED_FETCH",
      "url": "https://www.rba.gov.au/statistics/tables/csv/d1-data.csv",
      "filename": "au-rba-d1.csv",
      "source_authority": "Reserve Bank of Australia",
      "series": "DGFABM12"
    },
    {
      "id": "AU_BROAD_MONEY_WEIGHT",
      "region": "AU",
      "role": "accounting_level_weight_input",
      "status": "VALIDATED_FETCH",
      "url": "https://www.rba.gov.au/statistics/tables/csv/d3-data.csv",
      "filename": "au-rba-d3.csv",
      "source_authority": "Reserve Bank of Australia",
      "series": "DMABMS"
    },
    {
      "id": "CN_M2",
      "region": "CN",
      "role": "money_signal_and_weight_input",
      "status": "UNRESOLVED",
      "url": null,
      "filename": "cn-pboc-m2.bin",
      "source_authority": "People's Bank of China",
      "note": "Official monthly Financial Statistics Report confirmed, but stable machine-readable source path is not yet validated. Do not replace with brittle chart scraping."
    },
    {
      "id": "JP_M2",
      "region": "JP",
      "role": "money_signal_and_weight_input",
      "status": "VALIDATED_FETCH",
      "url": "https://www.stat-search.boj.or.jp/api/v1/getDataCode?format=csv&lang=en&db=MD02&startDate=201501&code=MAM1NAM2M2MO",
      "filename": "jp-boj-m2.csv",
      "source_authority": "Bank of Japan Time-Series Data Search API",
      "series": "MD02'MAM1NAM2M2MO",
      "validation": {
        "min_bytes": 500,
        "must_contain": ["MAM1NAM2M2MO"]
      },
      "note": "Official BOJ main time-series table identifies the level series as MD02'MAM1NAM2M2MO; API requests use db=MD02 and the series code without the DB prefix."
    },
    {
      "id": "GB_M4",
      "region": "GB",
      "role": "money_signal_and_weight_input",
      "status": "VALIDATED_FETCH",
      "url": "https://www.bankofengland.co.uk/boeapps/database/_iadb-fromshowcolumns.asp?csv.x=yes&Datefrom=01/Jan/2015&Dateto=now&SeriesCodes=LPMAUYN&UsingCodes=Y&CSVF=CT&VPD=Y&VFD=N",
      "filename": "gb-boe-lpmauyn.csv",
      "source_authority": "Bank of England IADB",
      "series": "LPMAUYN",
      "validation": {
        "min_bytes": 500,
        "must_contain": ["LPMAUYN"]
      },
      "note": "Uses the Bank of England documented CSV export endpoint with Dateto=now and provider-native series code LPMAUYN."
    },
    {
      "id": "CA_M2",
      "region": "CA",
      "role": "money_signal_and_weight_input",
      "status": "VALIDATED_FETCH",
      "url": "https://www.bankofcanada.ca/valet/observations/V41552796/csv?start_date=2015-01-01",
      "filename": "ca-boc-v41552796.csv",
      "source_authority": "Bank of Canada Valet API",
      "series": "V41552796",
      "validation": {
        "min_bytes": 500,
        "must_contain": ["V41552796"]
      },
      "note": "Official Bank of Canada monetary aggregates table identifies V41552796 as seasonally adjusted gross M2; Valet observations supports CSV by series code."
    },
    {
      "id": "ASSET_ADJUSTED_PRICE_MIRROR",
      "region": "MARKET",
      "role": "frozen_asset_transmission_test_input",
      "status": "VALIDATED_FETCH",
      "capture_mode": "MULTIPART_HTTP",
      "source_authority": "Yahoo Finance chart API for SPY/QQQ/GLD/DBC/IEF/TLT; Digrin adjusted price history for BIL",
      "transform_contract": {
        "status": "NOT_EXECUTED_BY_RAW_CAPTURE",
        "tickers": ["SPY", "QQQ", "GLD", "DBC", "IEF", "TLT", "BIL"],
        "start_month": "2015-01",
        "frequency": "monthly",
        "price_field": "adjusted_price",
        "local_mirror_rounding_decimals": 2,
        "note": "v1.2 exact-ticker research mirror used these seven tickers; six were cross-checked to Yahoo/yfinance and BIL used Digrin adjusted-price history. Raw capture preserves provider bytes only; matrix transformation is a separate frozen gate."
      },
      "parts": [
        {
          "id": "SPY_YAHOO_ADJCLOSE",
          "ticker": "SPY",
          "url": "https://query1.finance.yahoo.com/v8/finance/chart/SPY?range=max&interval=1mo&events=history&includeAdjustedClose=true",
          "filename": "market-spy-yahoo-chart.json",
          "validation": {"min_bytes": 5000, "must_contain": ["\"symbol\":\"SPY\"", "adjclose"]}
        },
        {
          "id": "QQQ_YAHOO_ADJCLOSE",
          "ticker": "QQQ",
          "url": "https://query1.finance.yahoo.com/v8/finance/chart/QQQ?range=max&interval=1mo&events=history&includeAdjustedClose=true",
          "filename": "market-qqq-yahoo-chart.json",
          "validation": {"min_bytes": 5000, "must_contain": ["\"symbol\":\"QQQ\"", "adjclose"]}
        },
        {
          "id": "GLD_YAHOO_ADJCLOSE",
          "ticker": "GLD",
          "url": "https://query1.finance.yahoo.com/v8/finance/chart/GLD?range=max&interval=1mo&events=history&includeAdjustedClose=true",
          "filename": "market-gld-yahoo-chart.json",
          "validation": {"min_bytes": 5000, "must_contain": ["\"symbol\":\"GLD\"", "adjclose"]}
        },
        {
          "id": "DBC_YAHOO_ADJCLOSE",
          "ticker": "DBC",
          "url": "https://query1.finance.yahoo.com/v8/finance/chart/DBC?range=max&interval=1mo&events=history&includeAdjustedClose=true",
          "filename": "market-dbc-yahoo-chart.json",
          "validation": {"min_bytes": 5000, "must_contain": ["\"symbol\":\"DBC\"", "adjclose"]}
        },
        {
          "id": "IEF_YAHOO_ADJCLOSE",
          "ticker": "IEF",
          "url": "https://query1.finance.yahoo.com/v8/finance/chart/IEF?range=max&interval=1mo&events=history&includeAdjustedClose=true",
          "filename": "market-ief-yahoo-chart.json",
          "validation": {"min_bytes": 5000, "must_contain": ["\"symbol\":\"IEF\"", "adjclose"]}
        },
        {
          "id": "TLT_YAHOO_ADJCLOSE",
          "ticker": "TLT",
          "url": "https://query1.finance.yahoo.com/v8/finance/chart/TLT?range=max&interval=1mo&events=history&includeAdjustedClose=true",
          "filename": "market-tlt-yahoo-chart.json",
          "validation": {"min_bytes": 5000, "must_contain": ["\"symbol\":\"TLT\"", "adjclose"]}
        },
        {
          "id": "BIL_DIGRIN_ADJUSTED_PRICE",
          "ticker": "BIL",
          "url": "https://www.digrin.com/stocks/detail/BIL/price",
          "filename": "market-bil-digrin-price.html",
          "validation": {"min_bytes": 5000, "must_contain": ["BIL", "Adjusted price", "Price History"]}
        }
      ]
    }
  ]
}
